FROM node:24.21.0-bookworm@sha256:6dac556d980b7f0e5498d08f08cee0ca67798b4ad6c23964a9214920e67758d0
WORKDIR /game
# Only an archive verified by the trusted operator helper is copied here.
# Application compilation and dependency installation happen in Linux CI.
COPY runtime/ ./
ENV NODE_ENV=production HOST=0.0.0.0 PORT=5179
USER 1000:1000
EXPOSE 5179
CMD ["node", "dist-server/index.js"]
