# Examples only. No real credentials belong in this repository or a build.
GAME_DOMAIN=game.example.com
NODE_ENV=production
HOST=127.0.0.1
PORT=5179
MAX_ROOMS=4
ALLOWED_ORIGINS=https://game.example.com
# Empty by default. For a verified local reverse proxy only: 127.0.0.1,::1
TRUSTED_PROXY_IPS=
GAME_QA=0
# Docker build inputs; native builds get identity directly from git.
RELEASE_COMMIT=0000000000000000000000000000000000000000
RELEASE_DIRTY=true
# Explicit HTTPS origin required by the operator release script.
PUBLIC_ORIGIN=https://game.example.com
